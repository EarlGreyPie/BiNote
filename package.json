{
  "name": "mmlce",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc -b && pnpm --filter @mmlce/web typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @mmlce/web build",
    "dev": "pnpm --filter @mmlce/web dev",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/language": "6.12.4"
    }
  }
}
