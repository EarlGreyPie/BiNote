{
  "id": "./",
  "name": "BiNote 바이노트 · 마비노기 모바일 MML 악보 편집기",
  "short_name": "BiNote",
  "description": "마비노기 모바일 MML 악보 편집기 (비공식 팬 제작) · Mabinogi Mobile MML score editor (unofficial)",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FDEFD0",
  "theme_color": "#1f2430",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-binote-project": [".mme", ".mmlce"],
        "text/plain": [".mml", ".mmi"],
        "audio/midi": [".mid", ".midi"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [".mme", ".mmlce", ".mml", ".mmi", ".txt", ".mid", ".midi", "text/plain", "audio/midi", "audio/x-midi", "audio/*", "video/*", "application/octet-stream"]
        }
      ]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
